#!/usr/bin/env bash
#
# yourtermux-banner - Launcher that runs the best available banner script
# Author: JubairSenseiDev
#
# Fallback chain (in priority order):
#   1. banner-custom.sh   (user's custom banner, if it parses)
#   2. banner-go           (compiled Go binary, fastest)
#   3. banner.sh           (pure bash, always available)
#   4. banner.py           (Python 3 if available)
#   5. banner.js           (Node.js if available)
#   6. fallback inline message
#
# Install location: $HOME/.local/bin/yourtermux-banner
# Banner scripts location: $HOME/.local/share/yourtermux/banner/
#                         (or alongside this script in dev mode)
#
# Usage:
#   yourtermux-banner              # show banner with default color
#   yourtermux-banner --color red  # override color
#   yourtermux-banner --no-color   # disable colors
#

set -uo pipefail

# Find the banner directory (works for both installed and dev mode)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Priority list of banner directories
BANNER_DIRS=(
  "$HOME/.local/share/yourtermux/banner"
  "$HOME/.config/yourtermux/banner"
  "$SCRIPT_DIR/../banner"
  "$SCRIPT_DIR/banner"
  "$SCRIPT_DIR/../share/yourtermux/banner"
)

BANNER_DIR=""
for dir in "${BANNER_DIRS[@]}"; do
  if [[ -d "$dir" ]]; then
    BANNER_DIR="$dir"
    break
  fi
done

# Last-resort inline fallback (printed if no banner dir found)
fallback_inline() {
  cat <<'MSG'
    __   __ _______ _______ _______ ___   _______
    \ \ / /|  ___  |  ___  |  ___  |   | |  _____|
     \ V / | |   | | |   | | |   | |   | | |_____
      | |  | |   | | |   | | |   | |   | |_____  |
      | |  | |___| | |___| | |___| |___| |_____| |
      |_|  |_______|_______|_______|_______|_____|

    yourTermux — by JubairSenseiDev
    (no banner implementation found — run ./yourtermux.sh banner)
MSG
}

if [[ -z "$BANNER_DIR" ]]; then
  # No banner dir found — print inline fallback instead of erroring
  fallback_inline
  exit 0
fi

# Try each implementation in priority order, with safe fallback
run_banner() {
  # 1. Custom banner — but only if it parses AND runs without error
  if [[ -x "$BANNER_DIR/banner-custom.sh" ]]; then
    if bash -n "$BANNER_DIR/banner-custom.sh" 2>/dev/null; then
      # Try running it; if it exits non-zero (runtime error), fall through
      if bash "$BANNER_DIR/banner-custom.sh" "$@" 2>/dev/null; then
        exit 0
      fi
      # Custom banner ran but failed — fall through to next impl
    fi
  fi

  # 2. Compiled Go binary (fastest, no runtime needed)
  if [[ -x "$BANNER_DIR/banner-go" ]]; then
    exec "$BANNER_DIR/banner-go" "$@"
  fi

  # 3. Pure bash (always available on Termux)
  if [[ -r "$BANNER_DIR/banner.sh" ]]; then
    exec bash "$BANNER_DIR/banner.sh" "$@"
  fi

  # 4. Python 3
  if command -v python3 >/dev/null 2>&1 && [[ -r "$BANNER_DIR/banner.py" ]]; then
    exec python3 "$BANNER_DIR/banner.py" "$@"
  fi

  # 5. Node.js
  if command -v node >/dev/null 2>&1 && [[ -r "$BANNER_DIR/banner.js" ]]; then
    exec node "$BANNER_DIR/banner.js" "$@"
  fi

  # 6. Last-resort inline fallback
  fallback_inline
  exit 0
}

run_banner "$@"
